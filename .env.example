# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ---- Postgres (must match docker-compose.yml) ----
POSTGRES_USER=bazra
POSTGRES_PASSWORD=bazra
POSTGRES_DB=bazra
DATABASE_URL=postgresql+psycopg://bazra:bazra@localhost:5432/bazra

# ---- Backend ----
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=changeme-generate-a-real-random-value

# ---- Auth (Checkpoint 6) ----
SESSION_COOKIE_NAME=bazra_session
SESSION_COOKIE_SECURE=false

# ---- AI providers (added in Phase 3 — do not add keys before then) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Frontend (only VITE_-prefixed vars reach the browser build) ----
VITE_API_BASE_URL=http://localhost:8000
