# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ---- Postgres (must match docker-compose.yml) ----
# Host port is 5434 (not the default 5432) to avoid clashing with other local Postgres instances.
POSTGRES_USER=bazra
POSTGRES_PASSWORD=bazra
POSTGRES_DB=bazra
DATABASE_URL=postgresql+psycopg://bazra:bazra@localhost:5434/bazra

# ---- Backend ----
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=changeme-generate-a-real-random-value

# ---- Auth (Checkpoint 6) ----
SESSION_COOKIE_NAME=bazra_session
SESSION_COOKIE_SECURE=false

# ---- CORS (Checkpoint 2.1) ----
# Must match the frontend's real browser-facing origin, including port.
CORS_ALLOWED_ORIGIN=http://localhost:5174

# ---- AI providers (Phase 3, Checkpoint 3.1 — Model Router) ----
# Required for any real outbound model call, including this checkpoint's
# live verification step. Never logged, never persisted anywhere (see
# app/modules/model_router/ — ai_traces stores no prompt/response text or
# key material).
ANTHROPIC_API_KEY=
# Checkpoint 5.7 — Google Gemini, the second real provider. Explicit-only
# (see app/modules/model_router/gemini_service.py and
# complete_with_explicit_provider) — production routing is unchanged and
# never reaches Gemini merely because this key is set.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ---- Frontend (only VITE_-prefixed vars reach the browser build) ----
# Host port is 8001 (not the default 8000) to avoid clashing with other local backends.
VITE_API_BASE_URL=http://localhost:8001
